# Copy this file to `.env.local` and fill in real values for local development.
# Production values belong in your hosting provider's env config, not here.

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SkillBridge"
# Backend root including version prefix, e.g. https://api.skillsift.online/api/v1 or http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

AUTH_SECRET=""
